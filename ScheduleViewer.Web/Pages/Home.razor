    private async Task OnSearchInputAsync(ChangeEventArgs args)
    {
        search = args.Value?.ToString() ?? string.Empty;
        searchFocused = true;
        searchCancellation?.Cancel();
        searchCancellation?.Dispose();
        searchCancellation = null;
        searchResults = [];
        searchError = null;

        var query = search.Trim();
        if (query.Length < 2)
        {
            searchLoading = false;
            return;
        }

        var cancellation = new CancellationTokenSource();
        searchCancellation = cancellation;
        searchLoading = true;

        try
        {
            await Task.Delay(250, cancellation.Token);
            var results = await ApiClient.SearchSchedulesAsync(query, cancellation.Token);
            if (!cancellation.IsCancellationRequested && search.Trim() == query)
                searchResults = results.ToList();
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException)
        {
            if (!cancellation.IsCancellationRequested)
                searchError = "予定の検索に失敗しました";
        }
        finally
        {
            if (ReferenceEquals(searchCancellation, cancellation))
            {
                searchLoading = false;
                searchCancellation = null;
                cancellation.Dispose();
            }
        }
    }

    private static string FormatNumber(double value, string format) => value > 0 ? value.ToString(format) : "—";
    private static string FormatTime(DateTime? value) => value?.ToString("HH:mm") ?? "—";
    private static string FormatDuration(TimeSpan value)
    {
        if (value <= TimeSpan.Zero) return "—";
        var hours = (int)value.TotalHours;
        return hours > 0 ? $"{hours}時間{value.Minutes}分" : $"{value.Minutes}分";
    }

    private string FormatTaskDue(TaskRecord task)
    {
        if (task.DueDate is null) return "期限なし";
        var due = task.DueDate.Value;
        return due.TimeOfDay == TimeSpan.Zero ? due.ToString("M月d日") : due.ToString("M月d日 HH:mm");
    }

    private static string GetAttachmentIcon(string mimeType)
    {
        if (mimeType.Contains("pdf", StringComparison.OrdinalIgnoreCase)) return "📕";
        if (mimeType.Contains("image", StringComparison.OrdinalIgnoreCase)) return "🖼️";
        if (mimeType.Contains("video", StringComparison.OrdinalIgnoreCase)) return "🎬";
        if (mimeType.Contains("audio", StringComparison.OrdinalIgnoreCase)) return "🎵";
        if (mimeType.Contains("spreadsheet", StringComparison.OrdinalIgnoreCase) || mimeType.Contains("excel", StringComparison.OrdinalIgnoreCase)) return "📊";
        if (mimeType.Contains("presentation", StringComparison.OrdinalIgnoreCase) || mimeType.Contains("powerpoint", StringComparison.OrdinalIgnoreCase)) return "📽️";
        if (mimeType.Contains("document", StringComparison.OrdinalIgnoreCase) || mimeType.Contains("word", StringComparison.OrdinalIgnoreCase)) return "📘";
        return "📎";
    }

    private async Task LoadDayDataAsync()
    {
        dayLoading = true;
        dayError = null;
        try
        {
            var scheduleTask = ApiClient.GetSchedulesAsync(selectedDate);
            var tasksTask = ApiClient.GetTasksAsync(selectedDate);
            await Task.WhenAll(scheduleTask, tasksTask);
            scheduleItems = (await scheduleTask).ToList();
            photoLinks = ScheduleViewerApiClient.ExtractPhotoLinks(scheduleItems).ToList();
            attachmentLinks = ScheduleViewerApiClient.ExtractAttachmentLinks(scheduleItems).ToList();
            taskItems = (await tasksTask).ToList();
            loadedDayDate = selectedDate;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            scheduleItems = [];
            photoLinks = [];
            attachmentLinks = [];
            taskItems = [];
            loadedDayDate = null;
            dayError = "ScheduleViewer APIに接続できませんでした。APIが起動しているか確認してください。";
        }
        finally
        {
            dayLoading = false;
        }
    }

