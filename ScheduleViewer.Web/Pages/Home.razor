    private async Task AttachBoxFileAsync()
    {
        boxAttachError = null;
        if (boxAttachEvent is null || boxAttachEvent.EventId.Length == 0)
        {
            boxAttachError = "添付対象のイベントを特定できませんでした";
            return;
        }

        var url = boxAttachUrl.Trim();
        var fileName = boxAttachFileName.Trim();
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) ||
            uri.Scheme != Uri.UriSchemeHttps ||
            !(uri.Host.Equals("box.com", StringComparison.OrdinalIgnoreCase) ||
              uri.Host.EndsWith(".box.com", StringComparison.OrdinalIgnoreCase)))
        {
            boxAttachError = "有効なBox URL（https://app.box.com/...）を入力してください";
            return;
        }
        if (fileName.Length == 0)
        {
            boxAttachError = "表示用のファイル名を入力してください";
            return;
        }

        boxAttachSaving = true;
        try
        {
            await ApiClient.AttachBoxFileAsync(boxAttachEvent.EventId, url, fileName);
            CloseModal();
            await LoadDayDataAsync();
            await Notify("Boxファイルを添付しました");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            boxAttachError = "Boxファイルの添付に失敗しました";
        }
        finally
        {
            boxAttachSaving = false;
        }
    }
