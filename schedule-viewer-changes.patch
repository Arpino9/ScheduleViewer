index 0000000..1016e8b
--- /dev/null
+++ b/schedule-viewer-api/remove-task-scheduler.bat
@@ -0,0 +1,20 @@
+@echo off
+:: ScheduleViewer の自動起動タスクをタスクスケジューラから削除する
+
+set TASK=ScheduleViewer_AutoStart
+
+echo.
+echo  ScheduleViewer タスクスケジューラ解除
+echo  ----------------------------------------
+echo  タスク名: %TASK%
+echo.
+
+schtasks /delete /tn "%TASK%" /f
+
+if %errorlevel% equ 0 (
+    echo  [OK] タスクを削除しました。
+) else (
+    echo  [ERROR] タスクが見つからないか削除に失敗しました。
+)
+echo.
+pause
