+@echo off
+:: ScheduleViewer をログオン時に自動起動するタスクをタスクスケジューラに登録する
+:: 管理者権限なしで実行可能 (ログオンユーザーとして実行)
+
+set VBS=C:\Users\okaji\source\repos\ScheduleViewer\schedule-viewer-api\start-server-silent.vbs
+set TASK=ScheduleViewer_AutoStart
+
+echo.
+echo  ScheduleViewer タスクスケジューラ登録
+echo  ----------------------------------------
+echo  タスク名  : %TASK%
+echo  起動スクリプト: %VBS%
+echo  トリガー  : ログオン時 (30秒後)
+echo.
+
+schtasks /create ^
+  /tn "%TASK%" ^
+  /tr "wscript.exe \"%VBS%\"" ^
+  /sc onlogon ^
+  /delay 0000:30 ^
+  /ru "%USERNAME%" ^
+  /f
+
+if %errorlevel% equ 0 (
+    echo.
+    echo  [OK] タスクを登録しました。次回ログオン時から自動起動されます。
+    echo  解除するには remove-task-scheduler.bat を実行してください。
+) else (
+    echo.
+    echo  [ERROR] タスクの登録に失敗しました。
+)
+echo.
+pause
