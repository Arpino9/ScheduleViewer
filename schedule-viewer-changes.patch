+++ b/schedule-viewer-api/api/src/main/java/com/scheduleviewer/api/StartupInitializer.java
@@ -0,0 +1,42 @@
+package com.scheduleviewer.api;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.ApplicationArguments;
+import org.springframework.boot.ApplicationRunner;
+import org.springframework.stereotype.Component;
+
+import java.awt.Desktop;
+import java.net.URI;
+
+/**
+ * Spring Boot 起動完了後にブラウザで http://localhost:9080/ を自動的に開く。
+ * タスクスケジューラによる無人起動時でも、ユーザーが手動でURLを開かなくて済む。
+ * 各サービスの OAuth フローが先に起動されるよう 3 秒待ってからブラウザを開く。
+ */
+@Component
+public class StartupInitializer implements ApplicationRunner {
+
+    private static final Logger log = LoggerFactory.getLogger(StartupInitializer.class);
+    private static final String APP_URL = "http://localhost:9080/";
+
+    @Override
+    public void run(ApplicationArguments args) {
+        Thread.ofVirtual().start(() -> {
+            try {
+                // 各サービスの OAuth ブラウザタブが先に開くよう少し待つ
+                Thread.sleep(3_000);
+                if (Desktop.isDesktopSupported() && Desktop.getDesktop().isSupported(Desktop.Action.BROWSE)) {
+                    log.info("ブラウザで {} を開きます", APP_URL);
+                    Desktop.getDesktop().browse(URI.create(APP_URL));
+                } else {
+                    log.info("デスクトップブラウズ非対応のためスキップ: {}", APP_URL);
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } catch (Exception e) {
+                log.warn("ブラウザ自動起動に失敗しました: {}", e.getMessage());
+            }
+        });
+    }
+}
